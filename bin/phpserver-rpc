#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpServer\Client\Console;

$autoload = null;
foreach ([
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php',
] as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}
if ($autoload === null) {
    fwrite(STDERR, "phpserver-rpc: run composer install first\n");
    exit(1);
}

require $autoload;

/** @var list<string> $argv */
exit((new Console())->run($argv));
